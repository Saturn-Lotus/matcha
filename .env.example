# POSTGRES environment variables
POSTGRES_USER=matcha
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=matcha_db
SALT_ALGORITHM="sha256"
SALT="replace-me"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECTION_STRING=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# Mailer
APP_SERVICE='yourmailservice'
APP_PASSWORD='replace-me'
APP_EMAIL='yourappemail@gmail.com'

# Next.js environment variables
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000
DATABASE_URL=postgresql://matcha:replace-me@localhost:5432/matcha_db?sslmode=disable
SESSION_SECRET=replace-me
TOKEN_EXPIRY_HOURS=24

# Neo4j environment variables
NEO4J_AUTH=neo4j/replace-me

# Storage configuration
STORAGE_TYPE=minio
STORAGE_BUCKET_NAME=matcha

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-me
MINIO_BUCKET=${STORAGE_BUCKET_NAME}
MINIO_ENDPOINT=minio
MINIO_PORT=9000

BLOB_READ_WRITE_TOKEN="replace-me"

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Socket server (internal notification bridge)
# In production: NEXT_PUBLIC_SOCKET_URL / SOCKET_INTERNAL_URL point at the
# Railway public domain (https://), and SOCKET_CORS_ORIGIN at the Vercel domain.
# NEXT_PUBLIC_SOCKET_URL is inlined at build time — it must be set on Vercel
# before `vercel build`, not only at runtime. See DEPLOYMENT.md.
SOCKET_PORT=4001
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
SOCKET_INTERNAL_URL=http://localhost:4001
SOCKET_INTERNAL_SECRET=replace-me
SOCKET_CORS_ORIGIN=http://localhost:3000
